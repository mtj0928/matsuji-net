---
import { formatDate } from '../../utils/date';
import { getPublishedPosts } from '../../utils/blog';

// 最新のブログ記事を3件取得
const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<div class="card p-6">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-2xl font-semibold">Recent Posts</h2>
    <a href="/blog" class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 text-sm font-medium transition-colors">
      もっと見る →
    </a>
  </div>

  <div class="space-y-4">
    {recentPosts.map((post) => (
      <article class="py-4 px-0 sm:px-4 rounded-lg hover:bg-gray-50 dark:hover:bg-neutral-900 transition-colors group relative">
        <a
          href={`/blog/${post.slug}`}
          class="absolute inset-0 z-10"
          aria-label={`${post.data.title}の記事を読む`}
        ></a>
        <h3 class="font-semibold mb-2 group-hover:text-gray-900 dark:group-hover:text-neutral-100 transition-colors">
          {post.data.title}
        </h3>
        {post.data.description && (
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-2 line-clamp-2">
            {post.data.description}
          </p>
        )}
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500 dark:text-neutral-400">
          <time datetime={post.data.pubDate.toISOString()} class="whitespace-nowrap shrink-0">
            {formatDate(post.data.pubDate)}
          </time>
          <div class="flex flex-wrap gap-1 min-w-0">
            {post.data.tags.map((tag) => (
              <a
                href={`/blog/tag/${encodeURIComponent(tag)}`}
                class="tag text-[11px] px-2 py-0.5 whitespace-nowrap relative z-20"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>
