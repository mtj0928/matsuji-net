---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';

const allWorks = await getCollection('works');
const sortedWorks = allWorks.sort((a, b) => a.data.order - b.data.order);
const sampleImage =
  'https://private-user-images.githubusercontent.com/12427733/291065628-5ba5419b-d0d1-4450-9a40-0e8b33133138.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..OCiR_0Qka_XKuEKTm1UJ2s12GyNn4n2PBm518VKIPnU';
const categories = [
  { key: 'presentation', label: '登壇' },
  { key: 'article', label: '記事執筆' },
  { key: 'oss', label: 'OSS' },
  { key: 'app', label: 'アプリ開発' },
];
const worksByCategory = categories
  .map((category) => ({
    ...category,
    items: sortedWorks.filter((work) => work.data.category === category.key),
  }))
  .filter((category) => category.items.length > 0);
---

<BaseLayout title="Works" description="これまでに作ったものや登壇・執筆の一覧です。">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 pt-8 pb-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Works</h1>
    </header>

    {worksByCategory.map((category) => (
      <section class="mb-12">
        <h2 class="text-xl font-bold mb-0 md:mb-1">{category.label}</h2>
        <div class="card p-6">
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {category.items.map((work) => (
              <a
                href={work.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative overflow-hidden rounded-2xl squircle-corners bg-gray-100 dark:bg-gray-800 aspect-square"
              >
                <img
                  src={work.data.image ?? sampleImage}
                  alt={work.data.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .squircle-corners {
    border-radius: 28px;
    corner-shape: squircle;
  }
</style>
