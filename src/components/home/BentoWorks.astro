---
import { getCollection } from 'astro:content';
import { fallbackWorkImage } from '../../utils/works';

// Featured worksのみを表示
const allWorks = await getCollection('works');
const featuredWorks = allWorks
  .filter((work) => work.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<div class="card p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Works</h2>
    <a href="/works" class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 text-sm font-medium transition-colors">
      もっと見る →
    </a>
  </div>

  <div class="grid grid-cols-3 gap-4">
    {featuredWorks.map((work) => {
      const imageSrc = work.data.image ?? fallbackWorkImage;

      return (
        <a
          href={work.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-2xl squircle-corners bg-gray-100 dark:bg-gray-800 aspect-square"
        >
          <img
            src={imageSrc}
            alt={work.data.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        </a>
      );
    })}
  </div>
</div>
