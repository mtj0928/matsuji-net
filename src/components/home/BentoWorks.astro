---
import { getCollection } from 'astro:content';

// Featured worksのみを表示
const allWorks = await getCollection('works');
const featuredWorks = allWorks
  .filter((work) => work.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<div class="card p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold">Works</h2>
    <a href="/works" class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 text-sm font-medium transition-colors">
      もっと見る →
    </a>
  </div>

  <div class="grid grid-cols-2 gap-4">
    {featuredWorks.map((work) => {
      const sizeClass = work.data.size === 'large' ? 'col-span-2' : 'col-span-1';
      return (
        <a
          href={work.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class={`${sizeClass} group relative overflow-hidden rounded-lg bg-gradient-to-br from-primary-500 to-primary-700 aspect-video flex items-center justify-center`}
        >
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/60 transition-colors flex flex-col justify-end p-4">
            <h3 class="text-white font-bold text-lg mb-1">{work.data.title}</h3>
            <p class="text-white/80 text-sm line-clamp-2">{work.data.description}</p>
          </div>
        </a>
      );
    })}
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
