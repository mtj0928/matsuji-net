---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Pagination from '../../components/blog/Pagination.astro';

const PAGE_SIZE = 10;

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.ceil(publishedPosts.length / PAGE_SIZE);
const posts = publishedPosts.slice(0, PAGE_SIZE);

// 全タグを取得
const allTags = [...new Set(publishedPosts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog" description="技術ブログ記事の一覧です。">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 pt-8 pb-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Blog</h1>
    </header>

    <!-- Tags Filter -->
    {allTags.length > 0 && (
      <div class="mb-8">
        <label for="tag-picker" class="sr-only">タグ選択</label>
        <div class="mt-3 max-w-xs">
          <select
            id="tag-picker"
            class="w-full rounded-lg border border-gray-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-neutral-600"
            onChange="if (this.value) window.location.href = this.value"
          >
            <option value="" selected>
              タグを選択
            </option>
            {allTags.map((tag) => (
              <option value={`/blog/tag/${tag}`}>{tag}</option>
            ))}
          </select>
        </div>
      </div>
    )}

    <!-- Blog Posts Grid -->
    <div class="space-y-4">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination currentPage={1} lastPage={totalPages} urlBase="/blog" />
  </div>
</BaseLayout>
