---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Pagination from '../../components/blog/Pagination.astro';

const PAGE_SIZE = 10;

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.ceil(publishedPosts.length / PAGE_SIZE);
const posts = publishedPosts.slice(0, PAGE_SIZE);

// 全タグを取得
const allTags = [...new Set(publishedPosts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog" description="技術ブログ記事の一覧です。">
  <div class="max-w-7xl mx-auto px-0 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Blog</h1>
      <p class="text-gray-600 dark:text-gray-400">
        技術に関する記事や学んだことを発信しています。
      </p>
    </header>

    <!-- Tags Filter -->
    {allTags.length > 0 && (
      <div class="mb-8">
        <h2 class="text-sm font-bold mb-3 text-gray-700 dark:text-gray-300">タグで絞り込む</h2>
        <div class="flex flex-wrap gap-2">
          {allTags.map((tag) => (
            <a
              href={`/blog/tag/${tag}`}
              class="tag hover:bg-gray-200 dark:hover:bg-neutral-700 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Blog Posts Grid -->
    <div class="space-y-6">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination currentPage={1} lastPage={totalPages} urlBase="/blog" />
  </div>
</BaseLayout>
