---
import { getCollection } from 'astro:content';
import { fallbackWorkImage, fetchOgp } from '../../utils/works';

// Featured worksのみを表示
const allWorks = await getCollection('works');
const featuredWorks = allWorks
  .filter((work) => work.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// ビルド時に各WorkのOGP情報を取得
const worksWithOgp = await Promise.all(
  featuredWorks.map(async (work) => {
    const ogp = await fetchOgp(work.data.link);
    return {
      ...work,
      ogp,
    };
  })
);
---

<div class="card p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Works</h2>
    <a href="/works" class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 text-sm font-medium transition-colors">
      もっと見る →
    </a>
  </div>

  <div class="grid grid-cols-1 gap-4">
    {worksWithOgp.map((work) => {
      const imageSrc = work.ogp?.image ?? work.data.image ?? fallbackWorkImage;
      const title = work.ogp?.title ?? work.data.title;
      const description = work.ogp?.description ?? work.data.description;

      return (
        <a
          href={work.data.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title}: ${description || 'No description available'}`}
          class="group flex flex-row rounded-lg hover:bg-gray-50 dark:hover:bg-neutral-900 transition-colors px-0 py-3 md:p-2"
        >
          {/* Image section - 16:9 aspect ratio, left side */}
          <div class="aspect-video w-36 sm:w-48 md:w-56 overflow-hidden bg-gray-100 dark:bg-gray-800 flex-shrink-0 rounded-md">
            <img
              src={imageSrc}
              alt={title}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          {/* Text section - right side */}
          <div class="flex-1 flex flex-col justify-start px-3 md:px-4 py-2 gap-1">
            <h3 class="text-sm md:text-base font-semibold line-clamp-2 text-gray-900 dark:text-white leading-tight">
              {title}
            </h3>
            {description && (
              <p class="text-xs md:text-sm text-gray-600 dark:text-gray-400 line-clamp-2 leading-snug">
                {description}
              </p>
            )}
          </div>
        </a>
      );
    })}
  </div>
</div>
