---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<article class="card py-6 px-0 md:p-6 group">
  <a href={`/blog/${post.slug}`} class="block">
    <div class="flex flex-col items-start gap-6 md:flex-row">
      <div class="flex-1 min-w-0 space-y-3">
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
          <time datetime={pubDate.toISOString()}>
            {formatDate(pubDate)}
          </time>
        </div>

        <h2 class="text-xl font-bold group-hover:text-gray-900 dark:group-hover:text-neutral-100 transition-colors">
          {title}
        </h2>

        <p class="text-gray-600 dark:text-gray-300 line-clamp-3">
          {description}
        </p>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {tags.map((tag) => (
              <span class="tag text-xs">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>

      {heroImage && (
        <div class="w-full md:w-40 lg:w-48 shrink-0">
          <div class="rounded-lg overflow-hidden bg-neutral-200 dark:bg-neutral-800">
            <img
              src={heroImage}
              alt=""
              loading="lazy"
              class="w-full h-24 md:h-28 lg:h-32 object-cover"
            />
          </div>
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
