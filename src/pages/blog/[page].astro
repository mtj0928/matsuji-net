---
import { getCollection } from 'astro:content';
import type { Page, GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Pagination from '../../components/blog/Pagination.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(publishedPosts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

// 全タグを取得
const allPosts = await getCollection('blog');
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title={`Blog - Page ${page.currentPage}`} description="技術ブログ記事の一覧です。">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 pt-8 pb-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Blog</h1>
    </header>

    <!-- Tags Filter -->
    {allTags.length > 0 && (
      <div class="mb-8">
        <label for="tag-picker" class="sr-only">タグ選択</label>
        <div class="mt-3 max-w-xs">
          <select
            id="tag-picker"
            class="w-full rounded-lg border border-gray-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-neutral-600"
            onChange="if (this.value) window.location.href = this.value"
          >
            <option value="" selected>
              タグを選択
            </option>
            {allTags.map((tag) => (
              <option value={`/blog/tag/${tag}`}>{tag}</option>
            ))}
          </select>
        </div>
      </div>
    )}

    <!-- Blog Posts Grid -->
    <div class="space-y-6">
      {page.data.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} urlBase="/blog" />
  </div>
</BaseLayout>
