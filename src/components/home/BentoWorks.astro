---
import { getCollection } from 'astro:content';

// Featured worksのみを表示
const allWorks = await getCollection('works');
const featuredWorks = allWorks
  .filter((work) => work.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const fallbackImage =
  'https://private-user-images.githubusercontent.com/12427733/291065628-5ba5419b-d0d1-4450-9a40-0e8b33133138.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..OCiR_0Qka_XKuEKTm1UJ2s12GyNn4n2PBm518VKIPnU';
---

<div class="card p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Works</h2>
    <a href="/works" class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 text-sm font-medium transition-colors">
      もっと見る →
    </a>
  </div>

  <div class="grid grid-cols-3 gap-4">
    {featuredWorks.map((work) => {
      const imageSrc = work.data.image ?? fallbackImage;
      const ogpLink = work.data.image ? undefined : work.data.link;

      return (
        <a
          href={work.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-2xl squircle-corners bg-gray-100 dark:bg-gray-800 aspect-square"
        >
          <img
            src={imageSrc}
            alt={work.data.title}
            data-ogp-link={ogpLink}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
  const ogpProxyUrl = (url) => {
    const normalized = url.replace(/^https?:\/\//, '');
    const scheme = url.startsWith('https://') ? 'https://' : 'http://';
    return `https://r.jina.ai/${scheme}${normalized}`;
  };

  const fetchOgpImage = async (url) => {
    try {
      const response = await fetch(ogpProxyUrl(url));
      if (!response.ok) return null;
      const html = await response.text();
      const match = html.match(
        /<meta[^>]+(?:property|name)=["']og:image(?::secure_url)?["'][^>]*content=["']([^"']+)["']/i
      );
      if (!match || !match[1]) return null;
      return new URL(match[1], url).toString();
    } catch {
      return null;
    }
  };

  const ogpImages = document.querySelectorAll('img[data-ogp-link]');
  ogpImages.forEach(async (img) => {
    const link = img.getAttribute('data-ogp-link');
    if (!link) return;
    const ogpImage = await fetchOgpImage(link);
    if (ogpImage) {
      img.src = ogpImage;
    }
  });
</script>

<style>
  .squircle-corners {
    border-radius: 28px;
    corner-shape: squircle;
  }
</style>
