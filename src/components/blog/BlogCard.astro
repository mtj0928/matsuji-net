---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<article class="card p-6 group">
  <a href={`/blog/${post.slug}`} class="block">
    {heroImage && (
      <div class="mb-4 rounded-lg overflow-hidden aspect-video bg-gradient-to-br from-primary-500 to-primary-700">
        <div class="w-full h-full flex items-center justify-center text-white/30 text-sm">
          {heroImage}
        </div>
      </div>
    )}

    <div class="space-y-3">
      <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>
      </div>

      <h2 class="text-xl font-bold group-hover:text-primary-500 dark:group-hover:text-primary-400 transition-colors">
        {title}
      </h2>

      <p class="text-gray-600 dark:text-gray-300 line-clamp-3">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {tags.map((tag) => (
            <span class="tag text-xs">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
