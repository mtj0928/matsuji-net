---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags: string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={heroImage}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Image -->
    {heroImage && (
      <div class="mb-8 rounded-xl overflow-hidden aspect-video bg-gradient-to-br from-primary-500 to-primary-700">
        <div class="w-full h-full flex items-center justify-center text-white/30">
          {heroImage}
        </div>
      </div>
    )}

    <!-- Header -->
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class="tag hover:bg-gray-200 dark:hover:bg-neutral-700 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>

      <h1 class="text-4xl md:text-5xl font-bold mb-4">{title}</h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
        <time datetime={pubDate.toISOString()}>
          公開: {formatDate(pubDate)}
        </time>
        {updatedDate && (
          <>
            <span>•</span>
            <time datetime={updatedDate.toISOString()}>
              更新: {formatDate(updatedDate)}
            </time>
          </>
        )}
      </div>
    </header>

    <!-- Content -->
    <div class="article-content">
      <slot />
    </div>

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800">
      <a
        href="/blog"
        class="inline-flex items-center text-primary-500 hover:text-primary-600 dark:text-neutral-200 dark:hover:text-neutral-100 transition-colors"
      >
        ← ブログ一覧に戻る
      </a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .article-content {
    color: #1f2937;
    line-height: 1.75;
  }

  .article-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #111827;
  }

  .article-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  .article-content p {
    margin-bottom: 1rem;
  }

  .article-content ul,
  .article-content ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .article-content li {
    margin-bottom: 0.5rem;
  }

  .article-content code {
    background-color: #f3f4f6;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  .article-content pre {
    background-color: #f3f4f6;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .article-content pre code {
    background-color: transparent;
    padding: 0;
  }

  .article-content a {
    color: #0ea5e9;
    transition: color 0.2s;
  }

  .article-content a:hover {
    color: #0284c7;
  }

  .article-content blockquote {
    border-left: 4px solid #0ea5e9;
    padding-left: 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: #4b5563;
  }

  .article-content strong {
    font-weight: 700;
    color: #111827;
  }

  @media (prefers-color-scheme: dark) {
    .article-content {
      color: #e5e7eb;
    }

    .article-content h2 {
      color: #f9fafb;
    }

    .article-content h3 {
      color: #f9fafb;
    }

    .article-content code {
      background-color: #1f2937;
    }

    .article-content pre {
      background-color: #1f2937;
    }

    .article-content a {
      color: #38bdf8;
    }

    .article-content a:hover {
      color: #7dd3fc;
    }

    .article-content blockquote {
      color: #9ca3af;
    }

    .article-content strong {
      color: #f9fafb;
    }
  }
</style>
