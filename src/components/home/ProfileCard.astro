---
import SocialLinks from '../common/SocialLinks.astro';

// TODO: 実際のプロフィール情報に置き換える
const profile = {
  name: 'matsuji',
  title: 'Software Engineer',
  bio: 'Web開発とモバイルアプリ開発が好きなエンジニアです。TypeScript、React、Swiftを主に使っています。OSS活動や技術ブログの執筆も行っています。',
  avatar: '/images/profile.jpg',
};
---

<div class="card p-8 max-w-xs">
  <div class="flex flex-col items-center text-center space-y-6">
    <!-- Avatar -->
    <img
      src="https://avatars.githubusercontent.com/u/12427733?v=4"
      alt={profile.name}
      class="w-32 h-32 rounded-full object-cover"
    />

    <!-- Name & Title -->
    <div>
      <h1 class="text-3xl font-bold mb-2">{profile.name}</h1>
      <p class="text-gray-600 dark:text-gray-400">{profile.title}</p>
    </div>

    <!-- Bio -->
    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
      {profile.bio}
    </p>

    <!-- Social Links -->
    <div class="pt-4">
      <SocialLinks />
    </div>
  </div>
</div>
