---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import BentoGrid from '../../components/works/BentoGrid.astro';

const allWorks = await getCollection('works');

// カテゴリーごとの件数
const categoryCounts = allWorks.reduce((acc, work) => {
  acc[work.data.category] = (acc[work.data.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categoryLabels: Record<string, string> = {
  oss: 'OSS',
  app: 'アプリ',
  presentation: '登壇',
  article: '記事',
};
---

<BaseLayout title="Works" description="これまでに作ったものや登壇・執筆の一覧です。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4">Works</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-6">
        これまでに作ったものや登壇・執筆活動の記録です。
      </p>

      <!-- Category Stats -->
      <div class="flex flex-wrap gap-4">
        {Object.entries(categoryCounts).map(([category, count]) => (
          <div class="card px-4 py-2">
            <span class="text-sm text-gray-600 dark:text-gray-400">
              {categoryLabels[category]}
            </span>
            <span class="ml-2 font-bold text-primary-500">
              {count}
            </span>
          </div>
        ))}
      </div>
    </header>

    <!-- Bento Grid -->
    <BentoGrid />
  </div>
</BaseLayout>
